---
layout: null
---
{
{% assign first = true %}
{% for post in site.posts %}
  {% unless first %},{% endunless %}{% assign first = false %}
  "{{ post.url | slugify }}": {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | jsonify }},
    "category": {{ post.categories[0] | jsonify }}
  }
{% endfor %}
{% for pg in site.pages %}
  {% if pg.title != nil %}
  {% unless first %},{% endunless %}{% assign first = false %}
  "{{ pg.url | slugify }}": {
    "title": {{ pg.title | jsonify }},
    "url": {{ pg.url | jsonify }}
  }
  {% endif %}
{% endfor %}
{% for doc in site.documents %}
  {% if doc.title != nil %}
  {% unless first %},{% endunless %}{% assign first = false %}
  "{{ doc.url | slugify }}": {
    "title": {{ doc.title | jsonify }},
    "url": {{ doc.url | jsonify }},
    "category": {{ doc.categories | jsonify }}
  }
  {% endif %}
{% endfor %}
}
